---
Checks: >
  -*,
  cert-*,
  clang-analyzer-*,
  bugprone-*,
  concurrency-*,
  llvm-header-guard,
  readability-isolate-declaration,
  readability-identifier-naming,
  readability-magic-numbers,
  readability-function-size,
  readability-function-cognitive-complexity,
  readability-uppercase-literal-suffix,
  cppcoreguidelines-avoid-non-const-global-variables,
  -bugprone-easily-swappable-parameters

# -bugprone-easily-swappable-parameters: allow foo(float a, float b)
#  misc-include-cleaner:  dropped
#                           - it adds unnecessary #include for internal headers
#                             (e.g. simd.h -> simd/scalar.h)

HeaderFilterRegex: '(src|include)/.*'   # check project headers
WarningsAsErrors: ''                    # warnings only
FormatStyle: file                       # use the closest .clang-format

CheckOptions:
  # --- Naming Conventions ---
  # lower_case for variables, parameters, and internal (static) functions
  # no prefix
  readability-identifier-naming.FunctionCase:           lower_case
  readability-identifier-naming.VariableCase:           lower_case
  readability-identifier-naming.ParameterCase:          lower_case

  # PascalCase for struct, union, enum, and typedef
  # with EF_ prefix (abbr. EulerFoil)
  readability-identifier-naming.StructCase:             CamelCase
  readability-identifier-naming.StructPrefix:           'EF_'

  readability-identifier-naming.UnionCase:              CamelCase
  readability-identifier-naming.UnionPrefix:            'EF_'

  readability-identifier-naming.EnumCase:               CamelCase
  readability-identifier-naming.EnumPrefix:             'EF_'

  readability-identifier-naming.TypedefCase:            CamelCase
  readability-identifier-naming.TypedefPrefix:          'EF_'

  # UPPER_CASE for enum constant, global constant
  # with EF_ prefix (abbr. EulerFoil)
  readability-identifier-naming.EnumConstantCase:       UPPER_CASE
  readability-identifier-naming.EnumConstantPrefix:     'EF_'

  readability-identifier-naming.GlobalConstantCase:     UPPER_CASE
  readability-identifier-naming.GlobalConstantPrefix:   'EF_'

  # UPPER_CASE for Macro
  # no prefix enforcement with since it will conflict   with header guard
  readability-identifier-naming.MacroDefinitionCase:    UPPER_CASE

  # lower_case for public (non-static) functions
  # with ef_ prefix (abbr. EulerFoil)
  readability-identifier-naming.GlobalFunctionCase:     lower_case
  readability-identifier-naming.GlobalFunctionPrefix:   'ef_'

  # 1024U marco warnings
  readability-uppercase-literal-suffix.IgnoreMacros:    false

  # --- Size Limit ---
  readability-function-size.LineThreshold:              65
  readability-function-cognitive-complexity.Threshold:  30
